{
  "name": "playbook",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build && node scripts/finalize-static-export.mjs",
    "prebuild": "fumadocs-mdx",
    "dev": "next dev",
    "start": "npx serve out",
    "lint": "eslint app lib components --ext .ts,.tsx",
    "test": "npm run build && npm run test:static",
    "test:static": "node --test scripts/static-export.test.mjs",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "verify:content": "node scripts/verify-public-content.mjs",
    "verify:routes": "node scripts/verify-static-export.mjs",
    "verify": "npm run verify:content && npm run types:check && npm run lint && npm run build && npm run test:static && npm run verify:routes"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "^16.8.0",
    "fumadocs-mdx": "^14.3.1",
    "fumadocs-ui": "^16.8.0",
    "lucide-react": "^0.513.0",
    "next": "16.2.12",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@next/eslint-plugin-next": "16.2.12",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.65.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
